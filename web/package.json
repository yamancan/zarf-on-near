{
  "name": "zarf-near-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@near-js/transactions": "2.5.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.3.0",
    "lucide-svelte": "0.563.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "secp256k1",
      "workerd"
    ]
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/hashes": "1.8.0"
  }
}
