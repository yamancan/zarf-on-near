{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zarf-near-mailer",
  "main": "src/index.ts",
  // No nodejs_compat: nothing here needs it, and it would copy secrets onto process.env.
  "compatibility_date": "2026-06-01",
  "vars": {
    "NETWORK": "testnet",
    // Empty values make every /notify 500 MAILER_MISCONFIGURED.
    "CONTRACT_ID": "",
    "NEAR_RPC_URL": "",
    "CLAIM_ORIGINS": "",
    "CLAIM_ORIGIN": "",
    "MAIL_FROM": ""
  },
  // RESEND_API_KEY: the owner puts it with `wrangler secret put RESEND_API_KEY --env testnet`; never in a file.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailGate"] }],
  "env": {
    // `wrangler dev --env testnet`; local runs set RESEND_URL to a stub and RESEND_API_KEY in .dev.vars.testnet.
    "testnet": {
      "name": "zarf-near-mailer-testnet",
      "workers_dev": true,
      "secrets": { "required": ["RESEND_API_KEY"] },
      "vars": {
        "NETWORK": "testnet",
        "CONTRACT_ID": "zarf-near-1112.testnet",
        "NEAR_RPC_URL": "https://test.rpc.fastnear.com",
        "CLAIM_ORIGINS": "https://near.zarf.to,https://zarf-near-claim-testnet.sparkling-queen-5e77.workers.dev",
        "CLAIM_ORIGIN": "https://near.zarf.to",
        "MAIL_FROM": "Zarf <claim@send.zarf.to>"
      },
      // One MailGate per campaign: once-per-commitment marks and the per-campaign count (CAP).
      "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "MailGate" }] },
      // 120 per minute per IP: one "Email All" of 100 recipients fits; a scripted flood does not.
      "ratelimits": [{ "name": "PER_IP", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } }]
    }
  }
}
