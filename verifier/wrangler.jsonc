{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zarf-near-verifier",
  "main": "src/index.ts",
  // No nodejs_compat: nothing here needs it, and it would copy secrets onto process.env.
  "compatibility_date": "2026-06-01",
  "vars": {
    // The OAuth web client id (S4). Empty fails closed: every request errors until it is set.
    "GOOGLE_CLIENT_ID": "",
    // Claim app origins allowed by CORS. The deployed claim host is added once the owner picks it.
    "CLAIM_ORIGINS": "",
    // The escrow contract's account id; it is signed into every payload.
    "CONTRACT_ID": "",
    // NEAR JSON-RPC endpoint the verifier reads the contract's views from.
    "NEAR_RPC_URL": ""
  },
  // SIGNER_SEED (hex32) is set with `wrangler secret put SIGNER_SEED`; requests 500 until it is.
  "secrets": { "required": ["SIGNER_SEED"] },
  "env": {
    // `wrangler dev --env dev`: vars are not inherited, so all of them are repeated here.
    "dev": {
      "vars": { "GOOGLE_CLIENT_ID": "", "CLAIM_ORIGINS": "http://localhost:5173", "CONTRACT_ID": "", "NEAR_RPC_URL": "" }
    },
    // `wrangler dev --env testnet --port 8787` against the live testnet contract (docs/deploy/testnet.md).
    // SIGNER_SEED comes from .dev.vars.testnet (scripts/testnet-dev-vars.sh). GOOGLE_CLIENT_ID stays
    // empty until the owner creates the OAuth client, so every claim fails closed until then.
    "testnet": {
      "secrets": { "required": ["SIGNER_SEED"] },
      "vars": { "GOOGLE_CLIENT_ID": "", "CLAIM_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173", "CONTRACT_ID": "zarf-near-1111.testnet", "NEAR_RPC_URL": "https://rpc.testnet.near.org" }
    }
  }
}
