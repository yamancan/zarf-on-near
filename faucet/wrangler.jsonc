{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zarf-near-faucet-testnet",
  // Deploy with an API token for this account; `wrangler whoami` must show it before any deploy.
  "account_id": "f0b938c1641f5223c48199ec45751913",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  // Testnet only: the worker refuses mainnet ids, a non-testnet RPC and Turnstile test keys off localhost.
  "vars": {
    "NETWORK": "testnet",
    // REQUIRED at rollout: next UTC date (YYYY-MM-DD), see QUOTA-ROLLOUT.md. Empty fails closed.
    "QUOTA_START_DATE": "",
    // Links name near.zarf.to (proxy/, T-029); /try is also served there, so Turnstile accepts that host too.
    "CLAIM_HOST": "https://near.zarf.to",
    "CONTRACT_ID": "zarf-near-1112.testnet",
    "TOKEN_ID": "3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af", // Circle testnet USDC
    "NEAR_RPC_URL": "https://test.rpc.fastnear.com", // rpc.testnet.near.org is deprecated and rate-limits per IP (Workers share egress)
    "FAUCET_SENDER_ID": "zarf-near-faucet-1112.testnet",
    "CREATOR": "testnet", // "stub" only answers on localhost/127.0.0.1 (local dev)
    "AMOUNT": "500000", // 0.5 test USDC (6 decimals): the float lasts twice as many runs
    "LIFETIME_S": "604800", // claim window: 7 days
    "PER_IP_PER_DAY": "6", // owner A-cap 2026-11-13
    "PER_EMAIL_PER_DAY": "1",
    "DAILY_CAP": "25", // links per UTC day (0.5 test USDC each); owner A-cap 2026-11-13
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF9RhGrCD61mJkz3" // widget zarf-near-faucet-testnet, domain = this worker's workers.dev host
  },
  // Secrets (wrangler secret put, or .dev.vars locally):
  // FAUCET_SENDER_KEY, LIMIT_KEY, TURNSTILE_SECRET.
  // Burst guard per IP before Turnstile and the chain (namespace ids 2001-2003 are the relayer's and verifier's).
  "ratelimits": [{ "name": "PER_IP", "namespace_id": "2004", "simple": { "limit": 3, "period": 10 } }],
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "FaucetQuota" }] },
  "migrations": [{ "tag": "faucet-quota-v1", "new_sqlite_classes": ["FaucetQuota"] }],
  "kv_namespaces": [{ "binding": "FAUCET_KV", "id": "4c8e6091866e45239c9de5144c334a3f" }]
}
