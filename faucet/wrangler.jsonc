{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zarf-near-faucet-testnet",
  // Deploy token: the default ~/.config/cloudflare/api-token; `wrangler whoami` must show this account.
  "account_id": "f0b938c1641f5223c48199ec45751913",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  // Testnet only: the worker refuses mainnet ids, a non-testnet RPC and Turnstile test keys off localhost.
  "vars": {
    "NETWORK": "testnet",
    "CLAIM_HOST": "https://zarf-near-claim-testnet.sparkling-queen-5e77.workers.dev",
    "CONTRACT_ID": "zarf-near-1112.testnet",
    "TOKEN_ID": "3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af", // Circle testnet USDC
    "NEAR_RPC_URL": "https://rpc.testnet.near.org",
    "FAUCET_SENDER_ID": "zarf-near-faucet-1112.testnet",
    "CREATOR": "testnet", // "stub" only answers on localhost/127.0.0.1 (local dev)
    "AMOUNT": "1000000", // 1 test USDC (6 decimals)
    "LIFETIME_S": "604800", // claim window: 7 days
    "PER_IP_PER_DAY": "3",
    "PER_EMAIL_PER_DAY": "1",
    "DAILY_CAP": "10", // the float: 10 test USDC, 1 per link
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF9RhGrCD61mJkz3" // widget zarf-near-faucet-testnet, domain = this worker's workers.dev host
  },
  // Secrets (wrangler secret put from ~/.config/zarf-near/*, or .dev.vars locally):
  // FAUCET_SENDER_KEY, LIMIT_KEY, TURNSTILE_SECRET.
  "kv_namespaces": [{ "binding": "FAUCET_KV", "id": "4c8e6091866e45239c9de5144c334a3f" }]
}
